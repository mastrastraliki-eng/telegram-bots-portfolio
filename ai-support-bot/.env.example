# Get a token from @BotFather (free)
BOT_TOKEN=123456:ABC-your-token

# Which model answers customers:
#   gemini - Google Gemini, free tier; get a key at https://aistudio.google.com/apikey
#   ollama - free local model, install from https://ollama.com and run `ollama pull qwen2.5:7b`
#   claude - Anthropic Claude API, best quality, needs a paid API key
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Where "Talk to a human" requests go: your user ID or a support group ID
SUPPORT_CHAT_ID=123456789
BUSINESS_NAME=Brew Lab Coffee
KNOWLEDGE_FILE=knowledge/brewlab.md
HISTORY_MESSAGES=20
